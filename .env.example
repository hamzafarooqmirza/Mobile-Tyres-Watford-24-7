# Supabase — obtain from your Supabase project dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Session signing secret — must be at least 32 random characters
# Generate one with: openssl rand -base64 32
SESSION_SECRET=replace-this-with-a-long-random-string-at-least-32-chars

# One-time setup token — protects /settings/setup from public access
# Choose any hard-to-guess string. After setup is complete this can be removed.
# Usage: yourdomain.co.uk/settings/setup?token=YOUR_VALUE
SETUP_TOKEN=replace-this-with-a-secret-token
